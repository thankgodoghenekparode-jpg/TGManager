# API base URL. When the backend is proxied through Vercel rewrites (vercel.json)
# or the Vite dev proxy, leave this empty so requests go to /api/v1 on the same
# origin (recommended for production to avoid cross-site cookie issues).
#
# Only  set this to a direct backend URL when you are NOT using the proxy and
# accept same-site cookie semantics:
#   VITE_API_BASE_URL=https://tgmanager-api.example.com/api/v1
#
VITE_API_BASE_URL=

# ---------------------------------------------------------------------------
# EmailJS (client-side admin notification emails - NOT SMTP)
# ---------------------------------------------------------------------------
# Used to notify the Super Admin when a customer submits an email change or
# password reset request. These values come from your EmailJS dashboard, not
# from this app's SMTP settings. If left blank, the admin notification is
# skipped (requests still work; the DB is the source of truth).
#   - VITE_EMAILJS_PUBLIC_KEY:     account public key (Settings > API Keys)
#   - VITE_EMAILJS_SERVICE_ID:     email service id (e.g. service_xxxxxxx)
#   - VITE_EMAILJS_TEMPLATE_EMAIL_CHANGE:  template id for "Email change requested"
#   - VITE_EMAILJS_TEMPLATE_PASSWORD_RESET: template id for "Password reset requested"
#   - VITE_SUPER_ADMIN_EMAIL:      recipient email passed to the template as to_email
#
# Create the two templates with a {{ to_email }} plus other params of your choice.
# These vars are baked into the frontend bundle; never inject secrets here.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_EMAIL_CHANGE=
VITE_EMAILJS_TEMPLATE_PASSWORD_RESET=
VITE_SUPER_ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# Marketing / sales page (public "/for-schools" brochure + proposal)
# ---------------------------------------------------------------------------
# Shown on the public schools page and in the "share to WhatsApp" messages.
VITE_COMPANY_NAME=TGManager
VITE_SALES_PHONE=+234 800 000 0000
VITE_SALES_EMAIL=sales@tgmanager.com
VITE_WEBSITE=https://tgmanager.com
VITE_SALES_WHATSAPP=

# ---------------------------------------------------------------------------
# One-click live demo (login page "Explore a live demo school" + /login?demo=1)
# ---------------------------------------------------------------------------
# Signs a visitor straight into a seeded demo school. Set VITE_DEMO_ENABLED=false
# to hide the demo button entirely (e.g. if the demo tenant is not seeded).
# The credentials below are the seeded demo school principal by default.
VITE_DEMO_ENABLED=true
VITE_DEMO_EMAIL=principal@tgeasymodel.edu.ng
VITE_DEMO_PASSWORD=password123
VITE_DEMO_SCHOOL=TGEasy Model College
