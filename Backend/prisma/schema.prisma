  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId       String
  student         Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId         String
  class           ClassRoom       @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId       String
  subject         Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  sessionId       String
  session         AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  termId          String
  term            Term            @relation(fields: [termId], references: [id], onDelete: Cascade)
  assignmentScore Float?
  testScore       Float?
  caScore         Float           @default(0)
  examScore       Float           @default(0)
  totalScore      Float           @default(0)
  grade           String?
  gradePoint      Float?
  remark          String?
  classPosition   Int?
  subjectPosition Int?
  status          ResultStatus    @default(DRAFT)
  locked          Boolean         @default(false)
  submittedAt     DateTime?
  approvedAt      DateTime?
  publishedAt     DateTime?
  approvedByUserId String?
  approvedBy      User?           @relation("ResultApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  approvals ResultApproval[]

  @@unique([tenantId, studentId, classId, subjectId, sessionId, termId])
  @@index([tenantId])
  @@index([classId, subjectId, sessionId, termId])
}

model ResultApproval {
  id        String         @id @default(cuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resultId  String
  result    AcademicResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  action    String
  userId    String
  notes     String?
  createdAt DateTime       @default(now())

  @@index([tenantId])
  @@index([resultId])
}

model FeeStructure {
  id        String           @id @default(cuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  category  String
  amount    Float
  sessionId String?
  session   AcademicSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  termId    String?
  term      Term?            @relation(fields: [termId], references: [id], onDelete: SetNull)
  classId   String?
  class     ClassRoom?       @relation(fields: [classId], references: [id], onDelete: SetNull)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  invoiceItems InvoiceItem[]

  @@index([tenantId])
}

model StudentInvoice {
  id             String          @id @default(cuid())
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sessionId      String?
  session        AcademicSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  termId         String?
  term           Term?           @relation(fields: [termId], references: [id], onDelete: SetNull)
  invoiceNumber  String
  totalAmount    Float
  discountAmount Float           @default(0)
  paidAmount     Float           @default(0)
  balance        Float
  dueDate        DateTime?
  status         PaymentStatus   @default(UNPAID)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  items    InvoiceItem[]
  payments SchoolPayment[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([studentId])
}

model InvoiceItem {
  id             String          @id @default(cuid())
  invoiceId      String
  invoice        StudentInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeStructureId String?
  feeStructure   FeeStructure?   @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)
  description    String
  amount         Float
  createdAt      DateTime        @default(now())

  @@index([invoiceId])
}

model SchoolPayment {
  id               String         @id @default(cuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId        String
  invoice          StudentInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  studentId        String
  student          Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  paymentReference String
  receiptNumber    String
  amount           Float
  method           PaymentMethod  @default(CASH)
  paymentDate      DateTime       @default(now())
  recordedByUserId String?
  recordedBy       User?          @relation("SchoolPaymentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  notes            String?
  createdAt        DateTime       @default(now())

  @@unique([tenantId, receiptNumber])
  @@index([tenantId])
  @@index([invoiceId])
  @@index([studentId])
}

model TimetablePeriod {
  id        String          @id @default(cuid())
  tenantId  String
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classId   String
  class     ClassRoom       @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId String?
  teacher   SchoolStaff?    @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  room      String?
  dayOfWeek DayOfWeek
  startTime String
  endTime   String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([tenantId])
  @@index([classId])
  @@index([teacherId])
}

model SchoolAnnouncement {
  id               String    @id @default(cuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title            String
  content          String
  audience         String    @default("ALL")
  publishedAt      DateTime  @default(now())
  createdByUserId  String?
  createdBy        User?     @relation("SchoolAnnouncementCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([tenantId])
}
