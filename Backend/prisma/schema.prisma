model StudentIdCard {
  id         String    @id @default(cuid())
  tenantId   String
  studentId  String
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  cardNumber String    @unique
  qrPayload  String
  issuedAt   DateTime  @default(now())
  expiresAt  DateTime?
  status     String    @default("ACTIVE")
