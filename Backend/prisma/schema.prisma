  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  employeeNumber  String
  firstName       String
  lastName        String
  phone           String?
  email           String?
  address         String?
  department      String?
  designation     String?
  category        StaffCategory @default(TEACHER)
  employmentDate  DateTime?
  photo           String?
  status          String        @default("ACTIVE")
