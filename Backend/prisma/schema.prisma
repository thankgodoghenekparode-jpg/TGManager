  @@index([status, createdAt])
}

model WeeklyReport {
  id                String       @id @default(cuid())
  tenantId          String
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submittedByUserId String
  submittedBy       User         @relation("WeeklyReportsSubmitted", fields: [submittedByUserId], references: [id], onDelete: Cascade)
  weekStart         DateTime     @db.Date
  weekEnd           DateTime     @db.Date
  notes             String?
  status            ReportStatus @default(SUBMITTED)
  attachmentIds     String[]     @default([])
  reviewedAt        DateTime?
  reviewedByUserId  String?
  reviewedBy        User?        @relation("WeeklyReportsReviewed", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([submittedByUserId, weekStart])
  @@index([tenantId])
  @@index([submittedByUserId])
