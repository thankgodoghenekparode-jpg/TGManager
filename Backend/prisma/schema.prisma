generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ============================= Enums =============================

enum UserRole {
  SUPER_ADMIN
  PLATFORM_SUPPORT
  COMPANY_ADMIN
  BRANCH_ADMIN
  USER
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL_ENDED
}

enum TenantOnboardingStatus {
  PENDING_BRANCH
  BRANCH_CREATED
  SCHEDULE_SET
  STAFF_ADDED
  COMPLETED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum ScheduleScope {
  BRANCH
  DEPARTMENT
  STAFF
}

enum AttendanceStatus {
  ON_TIME
  LATE
  EARLY_LEAVE
  OVERTIME
  MISSED_CLOCK_IN
  NO_CLOCK_OUT
  ABSENT
}

enum WorkflowAction {
  SUBMISSION
  APPROVE
  REJECT
  ACKNOWLEDGE
  PROVIDE_INFO
  EXECUTION
  CLOSURE
}

enum WorkflowStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum WorkflowStepStatus {
  PENDING
  COMPLETED
  REJECTED
}

enum AssigneeRuleType {
  COMPANY_ROLE
  USER
  ORIGINATOR_MANAGER
}

enum ConversationType {
  DIRECT
  GROUP
}

enum DocumentType {
  GENERAL
  INVENTORY
}

enum DocumentGrantPermission {
  READ
  WRITE
}

enum ReportStatus {
  SUBMITTED
  REVIEWED
}

enum EscalationType {
  AUTO_ACTION
  NOTIFY
  REASSIGN
}

enum EscalationTrigger {
  NO_RESPONSE
  ABSENT
  TIMEOUT
}

enum EscalationAction {
  APPROVE
  REJECT
  SKIP
  NOTIFY_ADMIN
}

enum IntegrationDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

enum AccountRequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

// ============================= Identity =============================

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole  @default(USER)
  avatarUrl    String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens                 RefreshToken[]
  tenantUsers                   TenantUser[]
  roleAssignments               RoleAssignment[]       @relation("RoleAssignmentsGranted")
  roleAssignmentsCreated        RoleAssignment[]       @relation("RoleAssignmentsAssignedBy")
  staffRecords                  StaffRecord[]
  departmentsManaged            Department[]
  attendanceRecords             Attendance[]
  documentsCreated              Document[]             @relation("DocumentsCreated")
  documentGrants                DocumentGrant[]        @relation("DocumentGrants")
  documentGrantsReceived        DocumentGrant[]        @relation("DocumentGrantsReceived")
  inventoryCreated              InventoryItem[]
  memosCreated                  Memo[]
  memoReads                     MemoRead[]
  formsCreated                  Form[]
  formSubmissions               FormSubmission[]
  companyRolesCreated           CompanyRole[]
  workflowTemplates             WorkflowTemplate[]
  workflowInstances             WorkflowInstance[]
  workflowStepsAssigned         WorkflowStep[]         @relation("WorkflowStepsAssignee")
  stepInstancesAssigned         WorkflowStepInstance[] @relation("StepInstancesAssignedTo")
  stepInstancesActioned         WorkflowStepInstance[] @relation("StepInstancesActionedBy")
  conversationsCreated          Conversation[]
  conversationMemberships       ConversationMember[]
  messages                      Message[]
  messageReads                  MessageRead[]
  auditLogs                     AuditLog[]
  notifications                 Notification[]
  pushSubscriptions             PushSubscription[]
  passwordResetTokens           PasswordResetToken[]
  emailChangeRequests           EmailChangeRequest[]   @relation("EmailChangeRequests")
  emailChangeRequestsReviewed   EmailChangeRequest[]   @relation("EmailChangeRequestsReviewed")
  passwordResetRequests         PasswordResetRequest[] @relation("PasswordResetRequests")
  passwordResetRequestsReviewed PasswordResetRequest[] @relation("PasswordResetRequestsReviewed")
  messageReactions              MessageReaction[]
  weeklyReportsSubmitted        WeeklyReport[]         @relation("WeeklyReportsSubmitted")
  weeklyReportsReviewed         WeeklyReport[]         @relation("WeeklyReportsReviewed")

  @@index([email])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ============================= Platform / Billing =============================

model Plan {
  id              String   @id @default(cuid())
  name            String
  code            String   @unique
  priceCents      Int      @default(0)
  maxBranches     Int?
  maxStaff        Int?
  maxDocuments    Int?
  maxStorageBytes BigInt?
  maxChatMessages Int?
  featureFlags    Json     @default("{}")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenants       Tenant[]
  subscriptions TenantSubscription[]
}

model Tenant {
  id               String                 @id @default(cuid())
  name             String
  slug             String                 @unique
  planId           String
  plan             Plan                   @relation(fields: [planId], references: [id])
  status           TenantStatus           @default(ACTIVE)
  onboardingStatus TenantOnboardingStatus @default(PENDING_BRANCH)
  timezone         String                 @default("UTC")
  settings         Json                   @default("{}")
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  subscriptions       TenantSubscription[]
  tenantUsers         TenantUser[]
  branches            Branch[]
  departments         Department[]
  groups              Group[]
  staffRecords        StaffRecord[]
  companyRoles        CompanyRole[]
  roleAssignments     RoleAssignment[]
  schedules           Schedule[]
  attendanceRecords   Attendance[]
  documents           Document[]
  inventoryItems      InventoryItem[]
  memos               Memo[]
  forms               Form[]
  formSubmissions     FormSubmission[]
  workflowTemplates   WorkflowTemplate[]
  workflowInstances   WorkflowInstance[]
  formRefCounters     FormRefCounter[]
  conversations       Conversation[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  integrationApiKeys  IntegrationApiKey[]
  integrationWebhooks IntegrationWebhook[]
  weeklyReports       WeeklyReport[]
  pushSubscriptions   PushSubscription[]

  @@index([planId])
}

model TenantSubscription {
  id        String             @id @default(cuid())
  tenantId  String
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId    String
  plan      Plan               @relation(fields: [planId], references: [id])
  status    SubscriptionStatus @default(TRIAL)
  startsAt  DateTime           @default(now())
  endsAt    DateTime?
  createdAt DateTime           @default(now())

  @@index([tenantId])
  @@index([planId])
}

model TenantUser {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([tenantId, userId])
  @@index([userId])
}

// ============================= Organization =============================

model Branch {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  address      String
  latitude     Float
  longitude    Float
  radiusMeters Float?
  phoneNumber  String?
  openingTime  String?
  closingTime  String?
  workingDays  Int[]        @default([1, 2, 3, 4, 5])
  timezone     String       @default("UTC")
  status       BranchStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  departments       Department[]
  groups            Group[]
  staffRecords      StaffRecord[]
  schedules         Schedule[]
  attendanceRecords Attendance[]
  documents         Document[]
  inventoryItems    InventoryItem[]
  memos             Memo[]
  forms             Form[]
  workflowTemplates WorkflowTemplate[]
  workflowInstances WorkflowInstance[]
  companyRoles      CompanyRole[]
  roleAssignments   RoleAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Department {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name          String
  managerUserId String?
  managerUser   User?    @relation(fields: [managerUserId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  staffRecords StaffRecord[]
  schedules    Schedule[]

  @@unique([tenantId, branchId, name])
  @@index([tenantId, branchId])
}

model Group {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime @default(now())

  staffGroups StaffGroup[]

  @@unique([tenantId, branchId, name])
  @@index([tenantId, branchId])
}

model StaffRecord {
  id           String      @id @default(cuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  jobTitle     String?
  employeeCode String?
  isActive     Boolean     @default(true)
  joinedAt     DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  staffGroups       StaffGroup[]
  schedules         Schedule[]
  attendanceRecords Attendance[]

  @@unique([tenantId, userId, branchId])
  @@index([tenantId, branchId])
  @@index([tenantId, userId])
}

model StaffGroup {
  staffRecordId String
  staffRecord   StaffRecord @relation(fields: [staffRecordId], references: [id], onDelete: Cascade)
  groupId       String
  group         Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([staffRecordId, groupId])
  @@index([groupId])
}

// ============================= RBAC (company level) =============================

model CompanyRole {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId        String?
  branch          Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  isSystem        Boolean  @default(false)
  permissions     String[] @default([])
  createdByUserId String?
  createdByUser   User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assignments   RoleAssignment[]
  workflowSteps WorkflowStep[]

  @@unique([tenantId, branchId, name])
  @@index([tenantId])
}

model RoleAssignment {
  id               String      @id @default(cuid())
  tenantId         String
  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId           String
  user             User        @relation("RoleAssignmentsGranted", fields: [userId], references: [id], onDelete: Cascade)
  companyRoleId    String
  companyRole      CompanyRole @relation(fields: [companyRoleId], references: [id], onDelete: Cascade)
  branchId         String?
  branch           Branch?     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  assignedByUserId String?
  assignedByUser   User?       @relation("RoleAssignmentsAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime    @default(now())

  @@unique([tenantId, userId, companyRoleId, branchId])
  @@index([tenantId, userId])
  @@index([tenantId, companyRoleId])
}

// ============================= Schedules & Attendance =============================

model Schedule {
  id                String        @id @default(cuid())
  tenantId          String
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scope             ScheduleScope
  branchId          String?
  branch            Branch?       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  departmentId      String?
  department        Department?   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  staffRecordId     String?
  staffRecord       StaffRecord?  @relation(fields: [staffRecordId], references: [id], onDelete: Cascade)
  resumptionTime    String
  closingTime       String
  latePeriodMinutes Int           @default(120)
  workingDays       Int[]         @default([1, 2, 3, 4, 5])
  timezone          String        @default("UTC")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([tenantId, branchId])
}

model Attendance {
  id                String           @id @default(cuid())
  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId          String
  branch            Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staffRecordId     String?
  staffRecord       StaffRecord?     @relation(fields: [staffRecordId], references: [id], onDelete: SetNull)
  date              DateTime         @db.Date
  clockInAt         DateTime?
  clockInLat        Float?
  clockInLng        Float?
  clockOutAt        DateTime?
  clockOutLat       Float?
  clockOutLng       Float?
  lateMinutes       Int?
  earlyLeaveMinutes Int?
  overtimeMinutes   Int?
  status            AttendanceStatus @default(ABSENT)
  note              String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([tenantId, userId, date])
  @@index([tenantId, branchId, date])
  @@index([tenantId, date])
}

// ============================= Content =============================

model Document {
  id              String       @id @default(cuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId        String?
  branch          Branch?      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdByUser   User         @relation("DocumentsCreated", fields: [createdByUserId], references: [id], onDelete: Cascade)
  type            DocumentType @default(GENERAL)
  title           String
  storageKey      String?
  mimeType        String?
  sizeBytes       BigInt?
  version         Int          @default(1)
  metadata        Json         @default("{}")
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  grants   DocumentGrant[]
  messages Message[]

  @@index([tenantId, branchId])
  @@index([tenantId])
}

model DocumentGrant {
  id              String                  @id @default(cuid())
  documentId      String
  document        Document                @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId          String
  user            User                    @relation("DocumentGrantsReceived", fields: [userId], references: [id], onDelete: Cascade)
  permission      DocumentGrantPermission
  grantedByUserId String
  grantedByUser   User                    @relation("DocumentGrants", fields: [grantedByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime                @default(now())

  @@unique([documentId, userId])
  @@index([userId])
  @@index([documentId])
}

model InventoryItem {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId        String
  branch          Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sku             String?
  name            String
  quantity        Int      @default(0)
  unit            String?
  minQuantity     Int      @default(0)
  location        String?
  createdByUserId String
  createdByUser   User     @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, branchId])
}

model Memo {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId        String?
  branch          Branch?   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdByUser   User      @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  title           String
  body            String
  through         String?
  audience        Json      @default("{}")
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  reads MemoRead[]

  @@index([tenantId, branchId])
}

model MemoRead {
  id     String   @id @default(cuid())
  memoId String
  memo   Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt DateTime @default(now())

  @@unique([memoId, userId])
  @@index([userId])
}

model Form {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId         String?
  branch           Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdByUserId  String
  createdByUser    User     @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  isPublished      Boolean  @default(false)
  isCustomerTicket Boolean  @default(false)
  parentFormId     String?
  parentForm       Form?    @relation("FormChildForms", fields: [parentFormId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  fields            FormField[]
  submissions       FormSubmission[]
  workflowTemplates WorkflowTemplate[]
  childForms        Form[]             @relation("FormChildForms")

  @@index([tenantId, branchId])
  @@index([parentFormId])
}

model FormField {
  id       String  @id @default(cuid())
  formId   String
  form     Form    @relation(fields: [formId], references: [id], onDelete: Cascade)
  key      String
  label    String
  type     String
  required Boolean @default(false)
  options  Json    @default("[]")
  order    Int     @default(0)
  section  String  @default("General")
  roleKey  String?

  @@unique([formId, key])
  @@index([formId, section])
  @@index([formId, roleKey])
}

model FormSubmission {
  id                String            @id @default(cuid())
  tenantId          String
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  formId            String
  form              Form              @relation(fields: [formId], references: [id], onDelete: Cascade)
  submittedByUserId String
  submittedByUser   User              @relation(fields: [submittedByUserId], references: [id], onDelete: Cascade)
  refNumber         String
  parentRefNumber   String?
  instanceId        String?           @unique
  workflowInstance  WorkflowInstance? @relation("WorkflowInstanceSubmission")
  data              Json
  createdAt         DateTime          @default(now())

  @@index([tenantId, formId])
  @@index([tenantId, parentRefNumber])
}

model FormRefCounter {
  id         String @id @default(cuid())
  tenantId   String
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  year       Int
  lastNumber Int    @default(0)

  @@unique([tenantId, year])
}

// ============================= Workflows =============================

model WorkflowTemplate {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId        String?
  branch          Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdByUser   User     @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  formId          String?
  form            Form?    @relation(fields: [formId], references: [id], onDelete: SetNull)
  isActive        Boolean  @default(true)
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  steps     WorkflowStep[]
  instances WorkflowInstance[]

  @@index([tenantId, branchId])
}

model WorkflowStep {
  id                    String           @id @default(cuid())
  templateId            String
  template              WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name                  String
  order                 Int
  action                WorkflowAction   @default(APPROVE)
  assigneeRuleType      AssigneeRuleType @default(COMPANY_ROLE)
  assigneeCompanyRoleId String?
  assigneeCompanyRole   CompanyRole?     @relation(fields: [assigneeCompanyRoleId], references: [id], onDelete: SetNull)
  assigneeUserId        String?
  assigneeUser          User?            @relation("WorkflowStepsAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  isFinal               Boolean          @default(false)
  isRequired            Boolean          @default(true)
  dueInMinutes          Int?

  stepInstances   WorkflowStepInstance[]
  escalationRules WorkflowEscalation[]

  @@unique([templateId, order])
  @@index([templateId])
}

model WorkflowInstance {
  id                String           @id @default(cuid())
  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  templateId        String
  template          WorkflowTemplate @relation(fields: [templateId], references: [id])
  branchId          String?
  branch            Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  title             String
  status            WorkflowStatus   @default(PENDING)
  currentStepId     String?
  refNumber         String?
  parentRefNumber   String?
  submissionId      String?          @unique
  submission        FormSubmission?  @relation("WorkflowInstanceSubmission", fields: [submissionId], references: [id], onDelete: SetNull)
  initiatedByUserId String
  initiatedByUser   User             @relation(fields: [initiatedByUserId], references: [id], onDelete: Cascade)
  payload           Json             @default("{}")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  stepInstances WorkflowStepInstance[]

  @@index([tenantId, templateId])
}

model WorkflowStepInstance {
  id                       String             @id @default(cuid())
  instanceId               String
  instance                 WorkflowInstance   @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stepId                   String
  step                     WorkflowStep       @relation(fields: [stepId], references: [id], onDelete: Cascade)
  status                   WorkflowStepStatus @default(PENDING)
  assignedToUserId         String?
  assignedToUser           User?              @relation("StepInstancesAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  actionedById             String?
  actionedBy               User?              @relation("StepInstancesActionedBy", fields: [actionedById], references: [id], onDelete: SetNull)
  actionedAt               DateTime?
  data                     Json               @default("{}")
  note                     String?
  delegatedToUserId        String?
  originalAssignedToUserId String?

  @@index([instanceId])
}

model WorkflowEscalation {
  id             String            @id @default(cuid())
  stepId         String
  step           WorkflowStep      @relation(fields: [stepId], references: [id], onDelete: Cascade)
  type           EscalationType
  trigger        EscalationTrigger
  timeoutMinutes Int
  action         EscalationAction
  targetUserId   String?
  priority       Int               @default(0)
  createdAt      DateTime          @default(now())

  @@index([stepId])
}

// ============================= Chat =============================

enum MessageKind {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
  VOICE
}

model Conversation {
  id              String           @id @default(cuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type            ConversationType @default(DIRECT)
  name            String?
  createdByUserId String
  createdByUser   User             @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  members  ConversationMember[]
  messages Message[]

  @@index([tenantId])
}

model ConversationMember {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())
  muted          Boolean      @default(false)
  role           String       @default("MEMBER")

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id               String       @id @default(cuid())
  conversationId   String
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId         String
  sender           User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  kind             MessageKind  @default(TEXT)
  body             String?
  documentId       String?
  document         Document?    @relation(fields: [documentId], references: [id], onDelete: SetNull)
  parentId         String?
  parent           Message?     @relation("MessageReplies", fields: [parentId], references: [id], onDelete: SetNull)
  deletedForSender Boolean      @default(false)
  editedAt         DateTime?
  deletedAt        DateTime?
  createdAt        DateTime     @default(now())

  replies   Message[]         @relation("MessageReplies")
  reactions MessageReaction[]
  reads     MessageRead[]

  @@index([conversationId, createdAt])
  @@index([parentId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model MessageRead {
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now())

  @@id([messageId, userId])
  @@index([userId])
}

// ============================= Audit =============================

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json     @default("{}")
  ip         String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([userId])
}

// ============================= Notifications =============================

model Notification {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  data      Json      @default("{}")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([tenantId, createdAt])
}

// ============================= Push Subscriptions =============================

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tenantId])
}

// ============================= Platform Config =============================

model PlatformConfig {
  id        String   @id @default("platform")
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt
}

// ============================= Integrations =============================

model IntegrationApiKey {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  keyPrefix   String
  keyHash     String
  permissions String[]
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId])
  @@index([keyPrefix])
}

model IntegrationWebhook {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  url       String
  secret    String
  events    String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  deliveries IntegrationDelivery[]

  @@index([tenantId])
}

model IntegrationDelivery {
  id          String                    @id @default(cuid())
  webhookId   String
  webhook     IntegrationWebhook        @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  eventType   String
  payload     Json
  status      IntegrationDeliveryStatus @default(PENDING)
  attempts    Int                       @default(0)
  lastError   String?
  createdAt   DateTime                  @default(now())
  deliveredAt DateTime?

  @@index([webhookId])
  @@index([status])
}

// ============================= Account Requests =============================

model EmailChangeRequest {
  id             String               @id @default(cuid())
  userId         String
  user           User                 @relation("EmailChangeRequests", fields: [userId], references: [id], onDelete: Cascade)
  currentEmail   String
  requestedEmail String
  reason         String?
  status         AccountRequestStatus @default(PENDING)
  createdAt      DateTime             @default(now())
  reviewedAt     DateTime?
  reviewedById   String?
  reviewedBy     User?                @relation("EmailChangeRequestsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
  adminNote      String?

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([requestedEmail])
}

model PasswordResetRequest {
  id           String               @id @default(cuid())
  userId       String
  user         User                 @relation("PasswordResetRequests", fields: [userId], references: [id], onDelete: Cascade)
  email        String
  status       AccountRequestStatus @default(PENDING)
  createdAt    DateTime             @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?                @relation("PasswordResetRequestsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
  adminNote    String?

  @@index([userId, status])
  @@index([status, createdAt])
}

model WeeklyReport {
  id                String       @id @default(cuid())
  tenantId          String
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submittedByUserId String
  submittedBy       User         @relation("WeeklyReportsSubmitted", fields: [submittedByUserId], references: [id], onDelete: Cascade)
  weekStart         DateTime     @db.Date
  weekEnd           DateTime     @db.Date
  notes             String?
  status            ReportStatus @default(SUBMITTED)
  attachmentIds     String[]     @default([])
  reviewedAt        DateTime?
  reviewedByUserId  String?
  reviewedBy        User?        @relation("WeeklyReportsReviewed", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([submittedByUserId, weekStart])
  @@index([tenantId])
  @@index([submittedByUserId])
}

model DistributedLock {
  name       String   @id
  owner      String
  acquiredAt DateTime @default(now())
  expiresAt  DateTime

  @@index([expiresAt])
}
