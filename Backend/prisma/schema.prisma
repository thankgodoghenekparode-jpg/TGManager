  motto           String?
  principalName   String?
  schoolType      SchoolType    @default(SECONDARY)
  ownershipType   OwnershipType @default(PRIVATE)
  currency        String        @default("NGN")
  openingTime     String        @default("07:30")
  lateThreshold   String        @default("07:45")
  geofenceRadius  Float         @default(200)
  address         String?
  city            String?
  state           String?
  country         String        @default("Nigeria")
  phone           String?
  email           String?
  website         String?
  stampUrl        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Gate {
  id        String             @id @default(cuid())
  tenantId  String
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId  String?
  branch    Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name      String
  code      String
  location  String?
  status    String             @default("ACTIVE")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  attendance SchoolAttendance[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model AcademicSession {
  id        String             @id @default(cuid())
  tenantId  String
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  isCurrent Boolean            @default(false)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  terms         Term[]
  classes       ClassRoom[]
  results       AcademicResult[]
  feeStructures FeeStructure[]
  invoices      StudentInvoice[]
  assignments   Assignment[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Term {
  id                        String         @id @default(cuid())
  tenantId                  String
  sessionId                 String
  session                   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name                      String
  startDate                 DateTime?
  endDate                   DateTime?
  status                    TermStatus     @default(UPCOMING)
  isCurrent                 Boolean        @default(false)
  resultEntryOpen           Boolean        @default(true)
  resultSubmissionDeadline  DateTime?
  resultPublished           Boolean        @default(false)
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  results       AcademicResult[]
  feeStructures FeeStructure[]
  invoices      StudentInvoice[]
  assignments   Assignment[]

  @@unique([sessionId, name])
  @@index([tenantId])
  @@index([sessionId])
}

model ClassRoom {
  id             String           @id @default(cuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessionId      String?
  session        AcademicSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  name           String
  level          String
  section        String?
  capacity       Int              @default(40)
  classTeacherId String?
  classTeacher   SchoolStaff?     @relation("ClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)
  status         String           @default("ACTIVE")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  students         Student[]
  classSubjects    ClassSubject[]
  results          AcademicResult[]
  assignments      Assignment[]
  timetablePeriods TimetablePeriod[]
  feeStructures    FeeStructure[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Subject {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  code        String
  description String?
  category    String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  classSubjects    ClassSubject[]
  teacherSubjects  TeacherSubject[]
  results          AcademicResult[]
  assignments      Assignment[]
  timetablePeriods TimetablePeriod[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model ClassSubject {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classId   String
  class     ClassRoom    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId String?
  teacher   SchoolStaff? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())

  @@unique([classId, subjectId])
  @@index([tenantId])
}

model TeacherSubject {
  id        String      @id @default(cuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   SchoolStaff @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([teacherId, subjectId])
  @@index([tenantId])
}

model Student {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId        String?
  branch          Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  userId          String?
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  admissionNumber String
  qrIdentifier    String        @unique
  firstName       String
  middleName      String?
  lastName        String
  gender          String        @default("MALE")
  dateOfBirth     DateTime?
  passportPhoto   String?
  nationality     String        @default("Nigerian")
  stateOfOrigin   String?
  localGovernment String?
  religion        String?
  phone           String?
  email           String?
  address         String?
  admissionDate   DateTime      @default(now())
  previousSchool  String?
  currentClassId  String?
  currentClass    ClassRoom?    @relation(fields: [currentClassId], references: [id], onDelete: SetNull)
  armSection      String?
  house           String?
  bloodGroup      String?
  genotype        String?
  medicalNotes    String?
  status          StudentStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  guardians              StudentGuardian[]
  attendance             SchoolAttendance[]
  results                AcademicResult[]
  assignmentSubmissions  AssignmentSubmission[]
