# Application
NODE_ENV=development
PORT=4000

# Database (Prisma + driver adapter)
DATABASE_URL=postgresql://zarox:zarox@localhost:5432/zarox_connect

# Bootstrap seeding
# Set DB_SEED_ON_START=false to skip the automatic seed on startup.
# In production the demo org is only seeded when SEED_DEMO=true.
DB_SEED_ON_START=true
SEED_DEMO=true

# CORS: comma-separated list of allowed origins
# Production (separate domains): CORS_ORIGINS=https://zarox-connect-ui.vercel.app
CORS_ORIGINS=http://localhost:3000

# Auth
JWT_ACCESS_SECRET=replace-with-a-long-random-string-access
JWT_REFRESH_SECRET=replace-with-a-long-random-string-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Cookies
# COOKIE_SECURE=true is required when SameSite is 'none'.
# For cross-site (separate frontend/backend domains) use COOKIE_SAME_SITE=none.
# Cross-site setups rely on double-submit CSRF protection (zarox_csrf cookie +
# x-csrf-token header), enforced globally by the CsrfGuard.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Storage (S3) - used from Phase 4 onwards
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Frontend URL - used for password reset links
FRONTEND_URL=http://localhost:5173

# Email (SMTP) - in-app notifications always work; email is only sent when EMAIL_HOST is set
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=Zarox Connect <no-reply@zarox.example>
